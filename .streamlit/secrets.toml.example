# Copiar como .streamlit/secrets.toml y reemplazar la clave.
# Nunca subir secrets.toml al repositorio.
admin_password = "REEMPLAZAR_POR_UNA_CLAVE_SEGURA"

# false = permite monitor y prevalidación, pero bloquea la incorporación final.
# true  = habilita la publicación desde el portal tras confirmación humana.
admin_enable_writes = false
